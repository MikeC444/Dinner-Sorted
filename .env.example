# Copy this file to .env.local and fill in your own values.
# These are public client keys (safe to ship in the app). Never put secret keys here.

# Supabase: Project settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# RevenueCat: Project settings > API keys (public app-specific keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_XXXXXXXXXXXXXXXX

# Shown in the app (required by Apple for subscription apps)
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourdomain.co.uk
EXPO_PUBLIC_PRIVACY_URL=https://yourdomain.co.uk/privacy
EXPO_PUBLIC_TERMS_URL=https://yourdomain.co.uk/terms

# Set to 1 to skip sign-in and browse the app with built-in sample recipes (no backend needed)
EXPO_PUBLIC_DEMO=
