# Server-side secrets for the edge functions. Set them with:
#   npx supabase secrets set --env-file supabase/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)

# https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=
# https://developer.edamam.com/ (Recipe Search API)
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
# https://www.themealdb.com/api.php ("1" is the public test key; use your supporter key for release)
THEMEALDB_API_KEY=1

# Any long random string; paste the same value into RevenueCat's webhook Authorization header
REVENUECAT_WEBHOOK_SECRET=

# How long fetched recipes are cached. Keep within each provider's caching terms.
CACHE_TTL_HOURS=1
